{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusera.local/superpowers/contracts/artifacts/qa-report.schema.json",
  "title": "QAReport Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "run_id",
    "status",
    "producer_stage",
    "input_refs",
    "validation",
    "payload"
  ],
  "properties": {
    "artifact_type": { "const": "QAReport" },
    "schema_version": { "const": "1.0.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "validated", "rejected", "superseded"] },
    "producer_stage": { "const": "verify-publishable-page" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_spec_ref",
        "preview_build_ref",
        "verdict",
        "gate_results",
        "issues",
        "repair_directives",
        "evidence_refs",
        "waiver"
      ],
      "properties": {
        "page_spec_ref": { "type": "string", "minLength": 1 },
        "preview_build_ref": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "verdict": { "enum": ["pass", "fail", "waived"] },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "result", "blocking", "waivable", "evidence_refs"],
            "properties": {
              "gate_id": { "type": "string", "minLength": 1 },
              "result": { "enum": ["pass", "fail", "waived"] },
              "blocking": { "type": "boolean" },
              "waivable": { "type": "boolean" },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue_id",
              "severity",
              "category",
              "repairability",
              "blocking",
              "location_ref",
              "summary"
            ],
            "properties": {
              "issue_id": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["low", "medium", "high", "critical"] },
              "category": { "type": "string", "minLength": 1 },
              "repairability": { "enum": ["machine-repairable", "manual-only"] },
              "blocking": { "type": "boolean" },
              "location_ref": { "type": "string" },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "repair_directives": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "waiver": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "role", "reason", "approved_at"],
              "properties": {
                "actor": { "type": "string", "minLength": 1 },
                "role": { "enum": ["release-approver", "admin"] },
                "reason": { "type": "string", "minLength": 1 },
                "approved_at": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    }
  }
}
