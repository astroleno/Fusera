{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusera.local/superpowers/contracts/artifacts/page-spec.schema.json",
  "title": "PageSpec Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "run_id",
    "status",
    "producer_stage",
    "input_refs",
    "validation",
    "payload"
  ],
  "properties": {
    "artifact_type": { "const": "PageSpec" },
    "schema_version": { "const": "1.0.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "validated", "rejected", "superseded"] },
    "producer_stage": { "const": "page-compile" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "sections", "token_refs", "asset_refs", "compile_targets"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["section_id", "section_type", "component", "props", "design_intent"],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "section_type": { "type": "string", "minLength": 1 },
              "component": { "type": "string", "minLength": 1 },
              "props": { "type": "object" },
              "design_intent": {
                "type": "object",
                "additionalProperties": false,
                "required": ["layout", "media", "copy", "proof", "motion"],
                "properties": {
                  "layout": { "type": "string", "minLength": 1 },
                  "media": { "type": "string", "minLength": 1 },
                  "copy": { "type": "string", "minLength": 1 },
                  "proof": { "type": "string", "minLength": 1 },
                  "motion": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "token_refs": { "type": "object", "additionalProperties": true },
        "asset_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compile_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["preview"] }
        }
      }
    }
  }
}
