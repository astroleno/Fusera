{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusera.local/superpowers/contracts/artifacts/product-brief.schema.json",
  "title": "ProductBrief Artifact",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ProofRefId": {
      "type": "string",
      "pattern": "^proof:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ClaimRefId": {
      "type": "string",
      "pattern": "^claim:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ProofRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_ref", "claim", "source", "url"],
      "properties": {
        "proof_ref": { "$ref": "#/$defs/ProofRefId" },
        "claim": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    },
    "ClaimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_ref", "claim", "proof_refs"],
      "properties": {
        "claim_ref": { "$ref": "#/$defs/ClaimRefId" },
        "claim": { "type": "string", "minLength": 1 },
        "proof_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProofRefId" }
        }
      }
    }
  },
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "run_id",
    "status",
    "producer_stage",
    "input_refs",
    "validation",
    "payload"
  ],
  "properties": {
    "artifact_type": { "const": "ProductBrief" },
    "schema_version": { "const": "1.0.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "validated", "rejected", "superseded"] },
    "producer_stage": { "const": "product-and-brand-brief" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "audiences",
        "core_problem",
        "value_props",
        "product_details",
        "cta_goal",
        "proof_inputs",
        "proof_sources",
        "claim_refs",
        "claim_policy"
      ],
      "properties": {
        "product_name": { "type": "string", "minLength": 1 },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "core_problem": { "type": "string", "minLength": 1 },
        "value_props": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "product_details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cta_goal": { "type": "string", "minLength": 1 },
        "proof_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proof_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProofRef" }
        },
        "claim_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClaimRef" }
        },
        "claim_policy": { "enum": ["proof-required", "low-proof", "no-claims"] }
      }
    }
  }
}
